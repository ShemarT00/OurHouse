# Copy to .env and fill in from your Supabase project (Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Flask server. Use your computer's LAN IP (not localhost) when testing on a phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
# OurHouse's feedback inbox for Settings → Send feedback. Use a dedicated address,
# never a personal one: it is built into the app. Leave empty to hide the row.
EXPO_PUBLIC_FEEDBACK_EMAIL=
